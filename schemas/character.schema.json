{
  "$defs": {
    "Amount": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "pattern": "^\\s*(\\d+\\s*%?|\\$\\{[^}]+\\})\\s*$",
          "type": "string"
        }
      ],
      "description": "A percentage of the maximum (`50%`) or a number of points."
    },
    "Automation": {
      "additionalProperties": false,
      "properties": {
        "combat": {
          "default": true,
          "type": "boolean"
        },
        "nuke": {
          "default": true,
          "type": "boolean"
        },
        "rest": {
          "default": true,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Avoid": {
      "additionalProperties": false,
      "description": "What a walk never uses. Rooms are places (aliases, slugs, names or keys, from the\ncompiled room files); areas are compiled areas; exits are silvermere's exit kinds as the\nroom files write them (`door`, `trap`, `toll`, ...).",
      "properties": {
        "areas": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "exits": {
          "default": [],
          "items": {
            "enum": [
              "normal",
              "spell",
              "key",
              "item",
              "toll",
              "action",
              "hidden",
              "door",
              "map_change",
              "trap",
              "text",
              "gate",
              "remote_action",
              "class",
              "race",
              "level",
              "timed",
              "ticket",
              "user_count",
              "block_guard",
              "alignment",
              "delay",
              "cast",
              "ability",
              "spell_trap"
            ]
          },
          "type": "array"
        },
        "rooms": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Place"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "CampRule": {
      "additionalProperties": false,
      "description": "Stay in a room and fight what comes.",
      "properties": {
        "at": {
          "$ref": "#/$defs/Place"
        },
        "look_every": {
          "default": "5s",
          "description": "How often the bot looks around (a bare Enter redraws the room), so it sees monsters\nthat arrive.",
          "pattern": "^\\s*(\\d+(ms|s|m|h)|\\$\\{[^}]+\\})\\s*$",
          "type": "string"
        }
      },
      "required": [
        "at"
      ],
      "type": "object"
    },
    "Channel": {
      "enum": [
        "telepath",
        "gangpath"
      ],
      "type": "string"
    },
    "CircuitRule": {
      "additionalProperties": false,
      "description": "Visit lairs as each fills again (#67, design §14.7), as MudPlay's Auto-Lair: a lair's\nclock starts at its last kill, and it's ready its respawn time later. The bot waits\nnext door, never stepping in early, and kills all it finds. A hunt of one monster is a\ncircuit of one lair. When no lair is ready the rules below it run.",
      "properties": {
        "lairs": {
          "description": "The lairs, as places.",
          "items": {
            "$ref": "#/$defs/Place"
          },
          "type": "array"
        },
        "pick": {
          "$ref": "#/$defs/Pick",
          "default": "soonest",
          "description": "Which lair next: `soonest`, the nearest that will be ready when the bot gets there,\nelse the one whose fight can start first; or `throughput`, the nearest, counting\ntime spent waiting as free."
        },
        "respawn": {
          "additionalProperties": {
            "description": "A duration: `250ms`, `30s`, `5m` or `1h`.",
            "pattern": "^\\s*(\\d+(ms|s|m|h)|\\$\\{[^}]+\\})\\s*$",
            "type": "string"
          },
          "description": "How long after its last kill each lair fills again, by the lair as written (its room\nnumber for the long form): `{ small-cavern: 4m }`. A lair left out takes the compiled\nroom file's time.",
          "type": "object"
        },
        "wait": {
          "default": "0s",
          "description": "How long the bot will wait outside a lair for it to fill, rather than give way to\nthe rules below; none by default.",
          "pattern": "^\\s*(\\d+(ms|s|m|h)|\\$\\{[^}]+\\})\\s*$",
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/When",
          "default": {}
        }
      },
      "required": [
        "lairs"
      ],
      "type": "object"
    },
    "Combat": {
      "additionalProperties": false,
      "properties": {
        "melee": {
          "$ref": "#/$defs/Melee",
          "default": "none"
        },
        "room_tiers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RoomTier"
          },
          "type": "array"
        },
        "stealth_opener": {
          "anyOf": [
            {
              "$ref": "#/$defs/StealthOpener"
            },
            {
              "type": "null"
            }
          ]
        },
        "targeting": {
          "default": [],
          "description": "Evaluated top-down; the first rule naming a monster in the room wins.",
          "items": {
            "$ref": "#/$defs/TargetingRule"
          },
          "type": "array"
        },
        "tiers": {
          "default": [],
          "description": "The first tier whose `min_mp` current MP meets is cast, re-picked every round.",
          "items": {
            "$ref": "#/$defs/Tier"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Gear": {
      "additionalProperties": false,
      "description": "One item of a character's gear.",
      "properties": {
        "at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Place"
            },
            {
              "type": "null"
            }
          ],
          "description": "The shop to buy it at, a place; left out, a shop the compiled room files say sells\nit."
        },
        "item": {
          "description": "The item's name, as the game lists it (`padded vest`).",
          "type": "string"
        },
        "use": {
          "$ref": "#/$defs/GearUse",
          "description": "`wield`, `wear`, or `light` (a light source, such as a torch)."
        }
      },
      "required": [
        "item",
        "use"
      ],
      "type": "object"
    },
    "GearRule": {
      "additionalProperties": false,
      "description": "Keep the character's `gear:` (#55): check the inventory when the routine starts and\nafter each rest, put on what's carried but not in use, and buy what's missing.",
      "properties": {
        "when": {
          "$ref": "#/$defs/When",
          "default": {}
        }
      },
      "type": "object"
    },
    "GearUse": {
      "description": "How an item is put to use.",
      "oneOf": [
        {
          "enum": [
            "wield",
            "wear"
          ],
          "type": "string"
        },
        {
          "const": "light",
          "description": "Lit, as a torch or a lantern is (`light <item>`), to see in a dark room.",
          "type": "string"
        }
      ]
    },
    "Login": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "description": "The account name; its password is `secrets.yaml` → `accounts.<account>`.",
          "type": "string"
        },
        "steps": {
          "$ref": "#/$defs/LoginSteps",
          "default": "default-silvermere"
        },
        "takeover": {
          "default": true,
          "description": "Answer Y to silvermere's \"already logged on\" question (design §6.2).",
          "type": "boolean"
        }
      },
      "required": [
        "account"
      ],
      "type": "object"
    },
    "LoginStep": {
      "additionalProperties": false,
      "description": "Wait for `wait`, then send `send` (`{account}` and `{password}` filled in).",
      "properties": {
        "send": {
          "type": "string"
        },
        "wait": {
          "type": "string"
        }
      },
      "required": [
        "wait",
        "send"
      ],
      "type": "object"
    },
    "LoginSteps": {
      "anyOf": [
        {
          "const": "default-silvermere"
        },
        {
          "items": {
            "$ref": "#/$defs/LoginStep"
          },
          "type": "array"
        }
      ],
      "description": "`default-silvermere`, or a list of { wait, send }."
    },
    "Melee": {
      "description": "The attack command when no tier fits (`a`, `bs`), or `none`.",
      "type": "string"
    },
    "Party": {
      "additionalProperties": false,
      "properties": {
        "invite_by_injection": {
          "default": false,
          "description": "Have the server inject `invite <bot>` when the leader is the proxied main character.",
          "type": "boolean"
        },
        "leader": {
          "description": "The leader to join after login.",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "$ref": "#/$defs/PartyRole",
          "default": "member"
        }
      },
      "type": "object"
    },
    "PartyRole": {
      "enum": [
        "member",
        "leader"
      ],
      "type": "string"
    },
    "Pick": {
      "description": "How a circuit picks its next lair.",
      "enum": [
        "soonest",
        "throughput"
      ],
      "type": "string"
    },
    "Place": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "name": {
              "description": "Its name, checked against the world's by `check`.",
              "type": "string"
            },
            "room": {
              "description": "The room's number, map/room.",
              "pattern": "^\\s*\\d+\\s*/\\s*\\d+\\s*$",
              "type": "string"
            }
          },
          "required": [
            "room"
          ],
          "type": "object"
        }
      ],
      "description": "A room: an alias, a slug (`weapons-shop`, `dungeon:entrance`), the game's name, a key (`1/2150`), or { room: 1/2150, name: \"Newhaven, Arena\" }."
    },
    "Pools": {
      "additionalProperties": false,
      "description": "HP and MP amounts; either may be left out.",
      "properties": {
        "hp": {
          "anyOf": [
            {
              "$ref": "#/$defs/Amount"
            },
            {
              "type": "null"
            }
          ]
        },
        "mp": {
          "anyOf": [
            {
              "$ref": "#/$defs/Amount"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "Remote": {
      "additionalProperties": false,
      "properties": {
        "allow": {
          "default": [],
          "description": "Who may send @ commands.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "channels": {
          "default": [
            "telepath",
            "gangpath"
          ],
          "items": {
            "$ref": "#/$defs/Channel"
          },
          "type": "array"
        },
        "warn_denied": {
          "default": false,
          "description": "Answer a refused command with the MegaMud failure reply.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Require": {
      "enum": [
        "sneaking",
        "hidden",
        "either"
      ],
      "type": "string"
    },
    "Rest": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "default": "rest",
          "description": "`rest`, or `meditate` where the class has it.",
          "type": "string"
        },
        "start_when_any": {
          "$ref": "#/$defs/Pools",
          "default": {},
          "description": "Start when either falls below."
        },
        "stop_when_all": {
          "$ref": "#/$defs/Pools",
          "default": {
            "hp": "100%",
            "mp": "100%"
          },
          "description": "Stop when both reach these."
        },
        "tell_leader": {
          "default": true,
          "description": "`@wait` to the leader at the start, `@ok` at the end.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "RestRule": {
      "additionalProperties": false,
      "description": "Walk to a room and rest there.",
      "properties": {
        "at": {
          "$ref": "#/$defs/Place"
        },
        "until": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pools"
            },
            {
              "type": "null"
            }
          ],
          "description": "Rest until both reach these; the character's `rest.stop_when_all` when left out."
        },
        "when": {
          "$ref": "#/$defs/When",
          "default": {},
          "description": "Left out, it's refused by the check, which says what it needs."
        }
      },
      "required": [
        "at"
      ],
      "type": "object"
    },
    "RoomTier": {
      "additionalProperties": false,
      "properties": {
        "min_enemies": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "min_mp": {
          "format": "int32",
          "type": "integer"
        },
        "spell": {
          "type": "string"
        }
      },
      "required": [
        "spell",
        "min_mp",
        "min_enemies"
      ],
      "type": "object"
    },
    "RoutineFile": {
      "additionalProperties": false,
      "description": "A routine file as written, its parameters already filled in.",
      "properties": {
        "avoid": {
          "$ref": "#/$defs/Avoid",
          "default": {
            "areas": [],
            "exits": [],
            "rooms": []
          },
          "description": "What its walks never use."
        },
        "do": {
          "description": "Its rules, read top-down: the first that applies wins.",
          "items": {
            "$ref": "#/$defs/Rule"
          },
          "type": "array"
        },
        "name": {
          "default": null,
          "description": "The routine's name; the file's name when left out.",
          "type": [
            "string",
            "null"
          ]
        },
        "params": {
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "default": {},
          "description": "Its parameters and their defaults, used as `${name}` in any value; a character may\nset them with `with:`.",
          "type": "object"
        },
        "places": {
          "default": null,
          "description": "The area its places are looked for in first.",
          "type": [
            "string",
            "null"
          ]
        },
        "prefer_not": {
          "additionalProperties": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "pattern": "^\\$\\{[^}]+\\}$",
                "type": "string"
              }
            ]
          },
          "default": {},
          "description": "Rooms walked through only when the way round is longer than this many steps more.",
          "type": "object"
        },
        "schema": {
          "default": null,
          "description": "The file's format: 1.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "do"
      ],
      "title": "mudparty routine file",
      "type": "object"
    },
    "RoutineRef": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "use": {
              "description": "The routine's file in routines/, without .yaml.",
              "type": "string"
            },
            "with": {
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "type": "object"
            }
          },
          "required": [
            "use"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/RoutineFile"
        }
      ],
      "description": "A routine in routines/ by name, { use: <name>, with: {...} } to set its parameters, or one written here."
    },
    "Rule": {
      "anyOf": [
        {
          "const": "gear"
        },
        {
          "const": "train"
        },
        {
          "additionalProperties": false,
          "properties": {
            "rest": {
              "$ref": "#/$defs/RestRule"
            }
          },
          "required": [
            "rest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "circuit": {
              "$ref": "#/$defs/CircuitRule"
            }
          },
          "required": [
            "circuit"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "camp": {
              "$ref": "#/$defs/CampRule"
            }
          },
          "required": [
            "camp"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "gear": {
              "$ref": "#/$defs/GearRule"
            }
          },
          "required": [
            "gear"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "train": {
              "$ref": "#/$defs/TrainRule"
            }
          },
          "required": [
            "train"
          ],
          "type": "object"
        }
      ],
      "description": "A rule: a map with one key (rest, circuit, camp, gear or train), or the bare word `gear` or `train`."
    },
    "StealthOpener": {
      "additionalProperties": false,
      "description": "The fork's spell backstab, for Avenger and Assassin bots.",
      "properties": {
        "require": {
          "$ref": "#/$defs/Require"
        },
        "spell": {
          "type": "string"
        }
      },
      "required": [
        "spell",
        "require"
      ],
      "type": "object"
    },
    "TargetingRule": {
      "anyOf": [
        {
          "enum": [
            "kill_order",
            "assist_leader",
            "fight_back"
          ]
        },
        {
          "additionalProperties": false,
          "properties": {
            "kill_order": {
              "type": "boolean"
            }
          },
          "required": [
            "kill_order"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "assist_leader": {
              "type": "boolean"
            }
          },
          "required": [
            "assist_leader"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "fight_back": {
              "type": "boolean"
            }
          },
          "required": [
            "fight_back"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "priority": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "priority"
          ],
          "type": "object"
        }
      ],
      "description": "A targeting rule: its name, or a map with one key."
    },
    "Tier": {
      "additionalProperties": false,
      "properties": {
        "min_mp": {
          "description": "Cast only while MP is at least this.",
          "format": "int32",
          "type": "integer"
        },
        "spell": {
          "description": "The short name the game accepts.",
          "type": "string"
        }
      },
      "required": [
        "spell",
        "min_mp"
      ],
      "type": "object"
    },
    "TrainRule": {
      "additionalProperties": false,
      "description": "Train a level at a trainer whenever the experience for it is there (#56): `- train`,\nor `- train: { at: guild, up_to: 3 }`. The fee is the game's (5 silver a level in\nNewhaven); one the bot can't pay is said, and tried again later.",
      "properties": {
        "at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Place"
            },
            {
              "type": "null"
            }
          ],
          "description": "The trainer; left out, those the compiled room files say train the character's\nclass (or any class), in the routine's `places` area first."
        },
        "up_to": {
          "description": "The highest level to train to: an arena's top level, say, since a level above it\nlocks the bot out. Left out, as high as the trainer goes.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "when": {
          "$ref": "#/$defs/When",
          "default": {}
        }
      },
      "type": "object"
    },
    "Unattended": {
      "additionalProperties": false,
      "description": "A character whose MudPlay has dropped stays in the game, idle, under its engine. It\nsets no statline of its own, so the user's comes back unchanged.",
      "properties": {
        "hang_up_below": {
          "anyOf": [
            {
              "const": "none"
            },
            {
              "$ref": "#/$defs/Amount"
            }
          ],
          "default": "30%",
          "description": "Hang up when HP falls below this (`30%`, or points), after recording where the\ncharacter is, so it can be found and rescued. `none` never hangs up."
        }
      },
      "type": "object"
    },
    "When": {
      "additionalProperties": false,
      "description": "When a rule starts. Every condition given must hold; none given always holds. A rule\nthat has started goes on until it's done, unless a rule above it starts.",
      "properties": {
        "hp_at_least": {
          "anyOf": [
            {
              "$ref": "#/$defs/Amount"
            },
            {
              "type": "null"
            }
          ]
        },
        "hp_below": {
          "anyOf": [
            {
              "$ref": "#/$defs/Amount"
            },
            {
              "type": "null"
            }
          ]
        },
        "mp_at_least": {
          "anyOf": [
            {
              "$ref": "#/$defs/Amount"
            },
            {
              "type": "null"
            }
          ]
        },
        "mp_below": {
          "anyOf": [
            {
              "$ref": "#/$defs/Amount"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One character's file: a bot's, or the main character's shorter one.",
  "properties": {
    "automation": {
      "$ref": "#/$defs/Automation",
      "default": {
        "combat": true,
        "nuke": true,
        "rest": true
      }
    },
    "autostart": {
      "default": false,
      "description": "Start as a headless bot when the server starts.",
      "type": "boolean"
    },
    "class": {
      "description": "The class, checked against game data.",
      "type": [
        "string",
        "null"
      ]
    },
    "combat": {
      "$ref": "#/$defs/Combat",
      "default": {
        "melee": "none",
        "room_tiers": [],
        "targeting": [],
        "tiers": []
      }
    },
    "gear": {
      "default": [],
      "description": "What the character carries (#55). A routine's `gear` rule keeps it so.",
      "items": {
        "$ref": "#/$defs/Gear"
      },
      "type": "array"
    },
    "login": {
      "anyOf": [
        {
          "$ref": "#/$defs/Login"
        },
        {
          "type": "null"
        }
      ],
      "description": "How a bot logs in; the main character logs in through MudPlay and has none."
    },
    "name": {
      "type": "string"
    },
    "party": {
      "$ref": "#/$defs/Party",
      "default": {
